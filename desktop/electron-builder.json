    "artifactName": "ArchiveRecon-${version}-win-x64.${ext}",
    "icon": "assets/icon.ico",
    "legalTrademarks": "Archive Recon",
    "signExecutable": false,
    "verifyUpdateCodeSignature": false
  },
  "extraMetadata": {
    "main": "dist/main/main.js",
    "productName": "Archive Recon",
    "author": {
      "name": "Archive Recon"
    }
  }
}
